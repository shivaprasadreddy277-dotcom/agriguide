# Environment Configuration Template for AgriGuide

# Node Environment Mode (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# Client App Origin (CORS and redirects whitelist)
APP_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection String
# Example: postgresql://username:password@localhost:5432/agriguide
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agriguide

# Official Google Gemini AI Config
GEMINI_API_KEY=replace-with-your-google-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_PROMPT_VERSION=v1

# Google OAuth2 Login Credentials
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Secure Session Signature Keys (Min 16 chars random secret)
SESSION_SECRET=replace-with-long-random-server-secret-signature
SESSION_TTL_DAYS=30

# Express Security Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ADVISORY_MAX=20

# Logging Verbosity Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
